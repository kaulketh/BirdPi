[Unit]
Description=BirdPi Web Interface
After=network.target

[Service]
Type=simple
User=kaulketh
WorkingDirectory=/home/kaulketh/birdpi/src

ExecStart=/home/kaulketh/birdpi/.venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --bind 0.0.0.0:5000 \
    --access-logfile - \
    --error-logfile - \
    birdpi.web.wsgi:app

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
