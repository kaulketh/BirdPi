[Unit]
Description=BirdPi Telegram Bot
After=network.target

[Service]
Type=simple
User=kaulketh
WorkingDirectory=/home/kaulketh/birdpi/src

EnvironmentFile=/etc/birdpi/birdpi.env

ExecStart=/home/kaulketh/birdpi/.venv/bin/python -m birdpi.telegram.bot

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target